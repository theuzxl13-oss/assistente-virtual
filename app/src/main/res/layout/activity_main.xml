<?xml version="1.0" encoding="utf-8"?>
<!--
  Tela pensada para quem não enxerga: o botão principal ocupa quase toda a tela (qualquer toque
  nele fala com a Bela ou interrompe), e os botões de apoio têm no mínimo 88dp de altura.
  A ordem de foco do TalkBack segue a ordem visual: título, estado, Falar, Repetir, Ajuda.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:gravity="center"
        android:text="@string/title_with_subtitle"
        android:textColor="@color/on_background"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:minHeight="48dp"
        android:text="@string/status_idle"
        android:textColor="@color/on_background"
        android:textSize="24sp" />

    <Button
        android:id="@+id/talkButton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_main_button"
        android:text="@string/button_talk"
        android:textAllCaps="false"
        android:textColor="@color/on_background"
        android:textSize="36sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/repeatButton"
            style="@style/SupportButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/button_repeat" />

        <Button
            android:id="@+id/helpButton"
            style="@style/SupportButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/button_help" />
    </LinearLayout>

</LinearLayout>
