<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AssistenteMae" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor" tools:targetApi="21">@color/background</item>
        <item name="android:navigationBarColor" tools:targetApi="21">@color/background</item>
    </style>

    <style name="SupportButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">88dp</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/on_background</item>
        <item name="backgroundTint">@color/support_button</item>
    </style>
</resources>
