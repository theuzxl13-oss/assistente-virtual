<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pesquisa, músicas e reconhecimento de voz online. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Ouvir a usuária (pedida na configuração inicial). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Encontrar contatos pelo nome. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Grupo "Telefone" (uma única janela): ligar, atender/recusar/desligar e saber se está tocando. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Número de quem está ligando, para dizer o nome. Nunca é guardado depois da chamada. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />

    <!--
      Sem nenhuma permissão de acessibilidade, sobreposição de tela, captura de tela ou leitura de
      notificações: são as permissões que fazem apps de banco bloquearem o celular.
    -->

    <queries>
        <!-- Motor de voz (TextToSpeech) e reconhecimento de fala: obrigatório a partir do Android 11. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- "Abra o WhatsApp": lista de apps com ícone na tela inicial. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.apps.youtube.music" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.AssistenteMae">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Permite escolher a Bela como "Assistente digital" padrão do Android: segurar o
                 botão de ligar abre a Bela já ouvindo. Só abre o app; não dá acesso à tela. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- "Compartilhar" um texto de outro app com a Bela para ela ler em voz alta. -->
            <intent-filter android:label="@string/share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".BelaTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification_mic"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.ACTIVE_TILE" android:value="false" />
        </service>

        <receiver
            android:name=".telephony.IncomingCallReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
